{
  "version": "1.0",
  "environment": "PRODUCTION",
  "input_lifecycle": {
    "pending_directory": "input/pending",
    "processing_directory": "input/processing",
    "processed_directory": "input/processed",
    "error_directory": "input/error"
  },
  "output": {
    "runs_directory": "output/runs"
  },
  "logs": {
    "directory": "logs"
  },
  "retention": {
    "enabled": true,
    "processed_days": 30,
    "error_days": 90,
    "output_runs_days": 90,
    "log_days": 90,
    "dry_run": true
  }
}